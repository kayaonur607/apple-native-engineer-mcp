# App Store Connect API credentials — read-only inspection only.
# Create a key at https://appstoreconnect.apple.com/access/api
# NEVER commit a real .p8 file: *.p8 and *.pem are git-ignored.

# 10-character Key ID from App Store Connect (e.g. 2X9R4HX743)
ASC_KEY_ID=YOUR_KEY_ID

# Issuer ID (UUID) shown above the key list
ASC_ISSUER_ID=YOUR_ISSUER_ID

# Path to the downloaded AuthKey_XXXXXXXXXX.p8
ASC_PRIVATE_KEY_PATH=/path/to/AuthKey_YOUR_KEY_ID.p8

# Alternative for CI: inline PEM or base64-encoded PEM
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# ASC_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTi...

# Optional: default app id for `versions` / `builds`
ASC_APP_ID=

# Optional tool overrides
# APPLE_NATIVE_PYTHON=python3
# APPLE_NATIVE_TIMEOUT_MS=180000
