# App Store Connect API Credentials (DO NOT COMMIT REAL SECRETS)
# Generate keys at: https://appstoreconnect.apple.com/access/api

# 1. Your 10-character Key ID from App Store Connect (e.g. 2X9R4HX743)
ASC_KEY_ID=YOUR_KEY_ID

# 2. Your Issuer ID UUID from App Store Connect (e.g. 57246542-96fe-1a63-e053-0824d011072a)
ASC_ISSUER_ID=YOUR_ISSUER_ID

# 3. Path to your downloaded .p8 private key file (e.g. ~/.appstoreconnect/AuthKey_2X9R4HX743.p8)
# Alternatively, you can provide ASC_PRIVATE_KEY_BASE64 in CI/CD environments.
ASC_PRIVATE_KEY_PATH=/path/to/AuthKey_YOUR_KEY_ID.p8

# Optional: Default App Apple ID for fast inspection
ASC_APP_ID=
