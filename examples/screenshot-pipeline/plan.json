{
  "bundle_id": "dev.applenative.plannerdemo",
  "app": "../../.swiftwork/PlannerDemo.app",
  "devices": [
    "iphone-6.9",
    "iphone-6.3",
    "ipad-13"
  ],
  "locales": [
    "en-US",
    "tr-TR"
  ],
  "appearances": [
    "light",
    "dark"
  ],
  "screens": [
    {
      "name": "01-today",
      "arguments": [
        "-screen",
        "today"
      ]
    },
    {
      "name": "02-insights",
      "arguments": [
        "-screen",
        "insights"
      ]
    }
  ],
  "settle_seconds": 3,
  "shutdown_after": true
}
